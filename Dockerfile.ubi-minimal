FROM redhat/ubi9-minimal

# set some metadata
LABEL summary="Apache https webdav server (ubi-minimal version)" \
      maintainer="Peter Pflaeging <peter@pflaeging.net>" \
      io.openshift.expose-services="8080:http"\
      io.openshift.expose-services="8081:http"

USER 0

# ubi-minimal specific installs and customizings
RUN microdnf update -y \
      && microdnf -y install httpd tar \
      && ln -sf /var/www/html /etc/httpd/htdocs
ADD httpd-foreground /usr/local/bin
RUN chmod 755 /usr/local/bin/httpd-foreground

# make /etc/passwd for group 0 writable
RUN chmod g=u /etc/passwd
RUN chown root:root /run/httpd && chmod 770 /run/httpd

# setup APP dir
ENV HOME=/etc/httpd

RUN mkdir -p /data && chmod -R g=u $HOME /data
WORKDIR $HOME

# replace httpd.conf
ADD httpd.conf $HOME/conf/httpd.conf
ADD dav-index.html $HOME/htdocs/

# copy entrypoint
ADD docker-entrypoint.sh /usr/local/bin/
RUN chmod 755 /usr/local/bin/docker-entrypoint.sh

# setups
VOLUME /data
EXPOSE 8080
EXPOSE 8081

USER 11177:0
# entrypoint makes setups
ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]
# cmd sets default command
CMD ["httpd-foreground"]
